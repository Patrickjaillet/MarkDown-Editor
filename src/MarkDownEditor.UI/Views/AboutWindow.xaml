<ui:FluentWindow
    x:Class="MarkDownEditor.UI.Views.AboutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    mc:Ignorable="d"
    Title="{Binding TitleText}"
    Width="500"
    MinWidth="480"
    MinHeight="500"
    SizeToContent="Height"
    ResizeMode="CanResize"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterOwner"
    ShowInTaskbar="False">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            Grid.Row="0"
            Title="{Binding TitleText}"
            ShowMaximize="False"
            ShowMinimize="False" />

        <StackPanel
            Grid.Row="1"
            Width="436"
            Margin="32,16,32,16"
            HorizontalAlignment="Center">

            <ui:SymbolIcon
                Symbol="DocumentText24"
                FontSize="48"
                HorizontalAlignment="Center"
                Margin="0,8,0,12" />

            <TextBlock
                Text="{Binding ProductName}"
                FontSize="22"
                FontWeight="SemiBold"
                HorizontalAlignment="Center" />

            <TextBlock
                Text="{Binding VersionText}"
                Opacity="0.7"
                FontSize="13"
                HorizontalAlignment="Center"
                Margin="0,2,0,16" />

            <TextBlock
                Text="{Binding CopyrightText}"
                FontSize="13"
                HorizontalAlignment="Center"
                Margin="0,0,0,4" />

            <TextBlock
                Text="{Binding LicenseMention}"
                FontSize="13"
                Opacity="0.85"
                TextWrapping="Wrap"
                TextAlignment="Center"
                HorizontalAlignment="Center"
                Margin="0,0,0,16" />

            <Border
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                Margin="0,0,0,16" />

            <Grid Margin="0,0,0,6" HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    Text="{Binding LicenseLabel}"
                    FontWeight="SemiBold"
                    FontSize="12"
                    Opacity="0.7"
                    Margin="0,0,8,0" />
                <TextBlock
                    Grid.Column="1"
                    Text="{Binding LicenseName}"
                    FontSize="12"
                    TextWrapping="Wrap" />
            </Grid>

            <Grid Margin="0,0,0,6" HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    Text="{Binding ContactLabel}"
                    FontWeight="SemiBold"
                    FontSize="12"
                    Opacity="0.7"
                    Margin="0,0,8,0" />
                <TextBlock
                    Grid.Column="1"
                    Text="{Binding ContactEmail}"
                    FontSize="12" />
            </Grid>

            <Grid Margin="0,0,0,16" HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    Text="{Binding WebsiteLabel}"
                    FontWeight="SemiBold"
                    FontSize="12"
                    Opacity="0.7"
                    Margin="0,0,8,0" />
                <TextBlock Grid.Column="1">
                    <Hyperlink
                        NavigateUri="{Binding WebsiteUrl}"
                        Click="OnWebsiteHyperlinkClick">
                        <Run Text="{Binding WebsiteUrl}" FontSize="12" />
                    </Hyperlink>
                </TextBlock>
            </Grid>

            <Grid HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ui:Button
                    Grid.Column="0"
                    Appearance="Secondary"
                    Click="OnOpenLicenseClick"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Padding="8,8">
                    <TextBlock
                        Text="{Binding LicenseFileLinkText}"
                        TextWrapping="Wrap"
                        TextAlignment="Center" />
                </ui:Button>
                <ui:Button
                    Grid.Column="2"
                    Appearance="Secondary"
                    Click="OnOpenThirdPartyNoticesClick"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Padding="8,8">
                    <TextBlock
                        Text="{Binding ThirdPartyNoticesLinkText}"
                        TextWrapping="Wrap"
                        TextAlignment="Center" />
                </ui:Button>
            </Grid>
        </StackPanel>

        <StackPanel
            Grid.Row="2"
            Orientation="Horizontal"
            HorizontalAlignment="Right"
            Margin="0,0,20,20">
            <ui:Button
                Content="{Binding CloseLabel}"
                Appearance="Primary"
                Click="OnCloseClick"
                MinWidth="96" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
