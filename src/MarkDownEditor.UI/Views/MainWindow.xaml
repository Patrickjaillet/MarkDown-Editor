<ui:FluentWindow
    x:Class="MarkDownEditor.UI.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
    xmlns:viewModels="clr-namespace:MarkDownEditor.UI.ViewModels"
    xmlns:core="clr-namespace:MarkDownEditor.Core;assembly=MarkDownEditor.Core"
    xmlns:converters="clr-namespace:MarkDownEditor.UI.Converters"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    mc:Ignorable="d"
    Title="{Binding WindowTitle}"
    Width="1280"
    Height="840"
    MinWidth="760"
    MinHeight="480"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterScreen">

    <!--
        Raccourcis clavier standards (voir ROADMAP.md, §6 Phase 3, polish
        UI / accessibilité clavier) : les mêmes commandes que les boutons
        de la barre d'actions, accessibles sans souris.
    -->
    <ui:FluentWindow.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewCommand}" />
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}" />
        <KeyBinding Key="S" Modifiers="Control+Shift" Command="{Binding SaveAsCommand}" />
        <KeyBinding Key="E" Modifiers="Control+Shift" Command="{Binding ExportHtmlCommand}" />
        <KeyBinding Key="T" Modifiers="Control" Command="{Binding ToggleThemeCommand}" />
        <KeyBinding Key="D1" Modifiers="Control" Command="{Binding SetViewModeCommand}" CommandParameter="Reading" />
        <KeyBinding Key="D2" Modifiers="Control" Command="{Binding SetViewModeCommand}" CommandParameter="Editing" />
        <KeyBinding Key="D3" Modifiers="Control" Command="{Binding SetViewModeCommand}" CommandParameter="Split" />
        <KeyBinding Key="F1" Command="{Binding ShowAboutCommand}" />
    </ui:FluentWindow.InputBindings>

    <ui:FluentWindow.Resources>
        <converters:ViewModeToBooleanConverter x:Key="ViewModeToBooleanConverter" />
        <converters:CountToVisibilityConverter x:Key="CountToVisibilityConverter" />
        <converters:HeadingLevelToIndentConverter x:Key="HeadingLevelToIndentConverter" />

        <!--
            Boutons icône-seule de la barre d'actions (remplacent les
            boutons WPF-UI texte + SymbolIcon d'origine). Les icônes
            elles-mêmes sont dessinées en vecteur directement dans le XAML
            (Canvas + Path/Rectangle/Ellipse/Line), sur le même principe
            qu'un fichier SVG, sans dépendance à une police d'icônes ni à
            un fichier image externe : conforme à la contrainte de
            portabilité 100 % hors-ligne du projet.
        -->
        <Style x:Key="ToolbarIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Background" Value="{DynamicResource ButtonBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlElevationBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource ControlCornerRadius}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource ButtonBackgroundPointerOver}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource ButtonBackgroundPressed}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource ButtonBackgroundDisabled}" />
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolbarIconToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border
                            x:Name="ToggleBorder"
                            Background="{DynamicResource ToggleButtonBackground}"
                            BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource ControlCornerRadius}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ToggleBorder" Property="Background" Value="{DynamicResource ToggleButtonBackgroundPointerOver}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ToggleBorder" Property="Background" Value="{DynamicResource ToggleButtonBackgroundChecked}" />
                                <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="{DynamicResource AccentControlElevationBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ToggleBorder" Property="Background" Value="{DynamicResource ToggleButtonBackgroundPressed}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Barre de titre personnalisée façon Windows 11. -->
        <ui:TitleBar
            Grid.Row="0"
            Title="{Binding WindowTitle}"
            ShowMaximize="True"
            ShowMinimize="True" />

        <!-- Barre d'actions principales : fichier, bascule de mode, thème. -->
        <StackPanel
            Grid.Row="1"
            Orientation="Horizontal"
            Margin="16,4,16,8">
            <!-- Nouveau -->
            <Button Style="{StaticResource ToolbarIconButtonStyle}" Command="{Binding NewCommand}">
                <Button.ToolTip>
                    <MultiBinding StringFormat="{}{0} ({1})">
                        <Binding Path="NewLabel" />
                        <Binding Path="NewShortcutLabel" />
                    </MultiBinding>
                </Button.ToolTip>
                <Viewbox Width="18" Height="18">
                    <Canvas Width="24" Height="24">
                        <Rectangle Canvas.Left="5" Canvas.Top="3" Width="12" Height="18" RadiusX="1.5" RadiusY="1.5"
                                   Stroke="{DynamicResource TextFillColorPrimaryBrush}" StrokeThickness="1.6" Fill="Transparent" />
                        <Line X1="8" Y1="15" X2="14" Y2="15" Stroke="{DynamicResource TextFillColorPrimaryBrush}"
                              StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        <Line X1="11" Y1="12" X2="11" Y2="18" Stroke="{DynamicResource TextFillColorPrimaryBrush}"
                              StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Canvas>
                </Viewbox>
            </Button>

            <!-- Ouvrir -->
            <Button Style="{StaticResource ToolbarIconButtonStyle}" Command="{Binding OpenCommand}">
                <Button.ToolTip>
                    <MultiBinding StringFormat="{}{0} ({1})">
                        <Binding Path="OpenLabel" />
                        <Binding Path="OpenShortcutLabel" />
                    </MultiBinding>
                </Button.ToolTip>
                <Viewbox Width="18" Height="18">
                    <Canvas Width="24" Height="24">
                        <Path Data="M3,8 L3,6 L9,6 L11,8" Stroke="{DynamicResource TextFillColorPrimaryBrush}"
                              StrokeThickness="1.6" StrokeLineJoin="Round" Fill="Transparent" />
                        <Rectangle Canvas.Left="3" Canvas.Top="8" Width="18" Height="11" RadiusX="1" RadiusY="1"
                                   Stroke="{DynamicResource TextFillColorPrimaryBrush}" StrokeThickness="1.6" Fill="Transparent" />
                    </Canvas>
                </Viewbox>
            </Button>

            <!-- Enregistrer -->
            <Button Style="{StaticResource ToolbarIconButtonStyle}" Command="{Binding SaveCommand}">
                <Button.ToolTip>
                    <MultiBinding StringFormat="{}{0} ({1})">
                        <Binding Path="SaveLabel" />
                        <Binding Path="SaveShortcutLabel" />
                    </MultiBinding>
                </Button.ToolTip>
                <Viewbox Width="18" Height="18">
                    <Canvas Width="24" Height="24">
                        <Rectangle Canvas.Left="4" Canvas.Top="4" Width="16" Height="16" RadiusX="1.5" RadiusY="1.5"
                                   Stroke="{DynamicResource TextFillColorPrimaryBrush}" StrokeThickness="1.6" Fill="Transparent" />
                        <Rectangle Canvas.Left="7.5" Canvas.Top="4" Width="9" Height="5"
                                   Stroke="{DynamicResource TextFillColorPrimaryBrush}" StrokeThickness="1.6" Fill="Transparent" />
                        <Rectangle Canvas.Left="7.5" Canvas.Top="14" Width="9" Height="6"
                                   Stroke="{DynamicResource TextFillColorPrimaryBrush}" StrokeThickness="1.6" Fill="Transparent" />
                    </Canvas>
                </Viewbox>
            </Button>

            <!-- Enregistrer sous -->
            <Button Style="{StaticResource ToolbarIconButtonStyle}" Command="{Binding SaveAsCommand}" Margin="0,0,20,0">
                <Button.ToolTip>
                    <MultiBinding StringFormat="{}{0} ({1})">
                        <Binding Path="SaveAsLabel" />
                        <Binding Path="SaveAsShortcutLabel" />
                    </MultiBinding>
                </Button.ToolTip>
                <Viewbox Width="18" Height="18">
                    <Canvas Width="24" Height="24">
                        <Path Data="M12,3 L12,14" Stroke="{DynamicResource TextFillColorPrimaryBrush}"
                              StrokeThickness="1.6" StrokeStartLineCap="Round" />
                        <Path Data="M8,10 L12,14 L16,10" Stroke="{DynamicResource TextFillColorPrimaryBrush}"
                              StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent" />
                        <Path Data="M5,17 L5,20 L19,20 L19,17" Stroke="{DynamicResource TextFillColorPrimaryBrush}"
                              StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent" />
                    </Canvas>
                </Viewbox>
            </Button>

            <!-- Bascule Lecture / Édition / Vue partagée. -->
            <ToggleButton
                Style="{StaticResource ToolbarIconToggleButtonStyle}"
                IsChecked="{Binding ViewMode, Converter={StaticResource ViewModeToBooleanConverter}, ConverterParameter=Reading, Mode=OneWay}"
                Command="{Binding SetViewModeCommand}"
                CommandParameter="Reading"
                ToolTip="{Binding ReadingModeLabel}">
                <Viewbox Width="18" Height="18">
                    <Canvas Width="24" Height="24">
                        <Path Data="M4,6 C7,4 10,4 12,6 C14,4 17,4 20,6 L20,18 C17,16 14,16 12,18 C10,16 7,16 4,18 Z"
                              Stroke="{DynamicResource TextFillColorPrimaryBrush}" StrokeThickness="1.5" StrokeLineJoin="Round" Fill="Transparent" />
                        <Line X1="12" Y1="6" X2="12" Y2="18" Stroke="{DynamicResource TextFillColorPrimaryBrush}" StrokeThickness="1.5" />
                    </Canvas>
                </Viewbox>
            </ToggleButton>
            <ToggleButton
                Style="{StaticResource ToolbarIconToggleButtonStyle}"
                IsChecked="{Binding ViewMode, Converter={StaticResource ViewModeToBooleanConverter}, ConverterParameter=Editing, Mode=OneWay}"
                Command="{Binding SetViewModeCommand}"
                CommandParameter="Editing"
                ToolTip="{Binding EditingModeLabel}">
                <Viewbox Width="18" Height="18">
                    <Canvas Width="24" Height="24">
                        <Path Data="M3,21 L3,17 L16,4 L20,8 L7,21 Z"
                              Stroke="{DynamicResource TextFillColorPrimaryBrush}" StrokeThickness="1.5" StrokeLineJoin="Round" Fill="Transparent" />
                        <Line X1="13" Y1="7" X2="17" Y2="11" Stroke="{DynamicResource TextFillColorPrimaryBrush}" StrokeThickness="1.2" />
                    </Canvas>
                </Viewbox>
            </ToggleButton>
            <ToggleButton
                Style="{StaticResource ToolbarIconToggleButtonStyle}"
                IsChecked="{Binding ViewMode, Converter={StaticResource ViewModeToBooleanConverter}, ConverterParameter=Split, Mode=OneWay}"
                Command="{Binding SetViewModeCommand}"
                CommandParameter="Split"
                Margin="0,0,20,0"
                ToolTip="{Binding SplitViewLabel}">
                <Viewbox Width="18" Height="18">
                    <Canvas Width="24" Height="24">
                        <Rectangle Canvas.Left="3" Canvas.Top="4" Width="8" Height="16" RadiusX="1" RadiusY="1"
                                   Stroke="{DynamicResource TextFillColorPrimaryBrush}" StrokeThickness="1.5" Fill="Transparent" />
                        <Rectangle Canvas.Left="13" Canvas.Top="4" Width="8" Height="16" RadiusX="1" RadiusY="1"
                                   Stroke="{DynamicResource TextFillColorPrimaryBrush}" StrokeThickness="1.5" Fill="Transparent" />
                    </Canvas>
                </Viewbox>
            </ToggleButton>

            <!-- Thème -->
            <Button Style="{StaticResource ToolbarIconButtonStyle}" Command="{Binding ToggleThemeCommand}">
                <Button.ToolTip>
                    <MultiBinding StringFormat="{}{0} ({1})">
                        <Binding Path="ToggleThemeLabel" />
                        <Binding Path="ToggleThemeShortcutLabel" />
                    </MultiBinding>
                </Button.ToolTip>
                <Viewbox Width="18" Height="18">
                    <Canvas Width="24" Height="24">
                        <Ellipse Canvas.Left="8" Canvas.Top="8" Width="8" Height="8"
                                 Stroke="{DynamicResource TextFillColorPrimaryBrush}" StrokeThickness="1.6" Fill="Transparent" />
                        <Line X1="12" Y1="1.5" X2="12" Y2="4.5" Stroke="{DynamicResource TextFillColorPrimaryBrush}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        <Line X1="12" Y1="19.5" X2="12" Y2="22.5" Stroke="{DynamicResource TextFillColorPrimaryBrush}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        <Line X1="1.5" Y1="12" X2="4.5" Y2="12" Stroke="{DynamicResource TextFillColorPrimaryBrush}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        <Line X1="19.5" Y1="12" X2="22.5" Y2="12" Stroke="{DynamicResource TextFillColorPrimaryBrush}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        <Line X1="4.8" Y1="4.8" X2="6.9" Y2="6.9" Stroke="{DynamicResource TextFillColorPrimaryBrush}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        <Line X1="17.1" Y1="17.1" X2="19.2" Y2="19.2" Stroke="{DynamicResource TextFillColorPrimaryBrush}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        <Line X1="4.8" Y1="19.2" X2="6.9" Y2="17.1" Stroke="{DynamicResource TextFillColorPrimaryBrush}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        <Line X1="17.1" Y1="6.9" X2="19.2" Y2="4.8" Stroke="{DynamicResource TextFillColorPrimaryBrush}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Canvas>
                </Viewbox>
            </Button>

            <!-- Export HTML -->
            <Button Style="{StaticResource ToolbarIconButtonStyle}" Command="{Binding ExportHtmlCommand}">
                <Button.ToolTip>
                    <MultiBinding StringFormat="{}{0} ({1})">
                        <Binding Path="ExportHtmlLabel" />
                        <Binding Path="ExportHtmlShortcutLabel" />
                    </MultiBinding>
                </Button.ToolTip>
                <Viewbox Width="18" Height="18">
                    <Canvas Width="24" Height="24">
                        <Path Data="M9,7 L4,12 L9,17" Stroke="{DynamicResource TextFillColorPrimaryBrush}"
                              StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent" />
                        <Path Data="M15,7 L20,12 L15,17" Stroke="{DynamicResource TextFillColorPrimaryBrush}"
                              StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent" />
                    </Canvas>
                </Viewbox>
            </Button>

            <!-- À propos -->
            <Button Style="{StaticResource ToolbarIconButtonStyle}" Command="{Binding ShowAboutCommand}" Margin="0">
                <Button.ToolTip>
                    <MultiBinding StringFormat="{}{0} ({1})">
                        <Binding Path="AboutLabel" />
                        <Binding Path="AboutShortcutLabel" />
                    </MultiBinding>
                </Button.ToolTip>
                <Viewbox Width="18" Height="18">
                    <Canvas Width="24" Height="24">
                        <Ellipse Canvas.Left="3" Canvas.Top="3" Width="18" Height="18"
                                 Stroke="{DynamicResource TextFillColorPrimaryBrush}" StrokeThickness="1.6" Fill="Transparent" />
                        <Line X1="12" Y1="11" X2="12" Y2="16.5" Stroke="{DynamicResource TextFillColorPrimaryBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        <Ellipse Canvas.Left="11.15" Canvas.Top="7" Width="1.7" Height="1.7" Fill="{DynamicResource TextFillColorPrimaryBrush}" />
                    </Canvas>
                </Viewbox>
            </Button>
        </StackPanel>

        <!--
            Zone de contenu principale : barre latérale des fichiers
            récents, puis rendu Lecture et/ou éditeur AvalonEdit selon le
            mode d'affichage actif.
        -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Barre latérale : onglets fichiers récents / table des matières. -->
            <Border
                Grid.Column="0"
                BorderThickness="0,0,1,0"
                Padding="0">
                <TabControl
                    Background="Transparent"
                    BorderThickness="0">
                    <TabItem Header="{Binding RecentFilesTabLabel}">
                        <DockPanel Margin="12">
                            <ListBox
                                ItemsSource="{Binding RecentFiles}"
                                BorderThickness="0"
                                Background="Transparent">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="4,6" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <EventSetter Event="MouseDoubleClick" Handler="OnRecentFileDoubleClick" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type viewModels:RecentFileEntry}">
                                        <TextBlock
                                            Text="{Binding FileName}"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTip="{Binding FilePath}" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock
                                DockPanel.Dock="Bottom"
                                Text="{Binding NoRecentFilesLabel}"
                                Opacity="0.6"
                                FontSize="12"
                                Margin="4,8,4,0"
                                TextWrapping="Wrap"
                                Visibility="{Binding RecentFiles.Count, Converter={StaticResource CountToVisibilityConverter}}" />
                        </DockPanel>
                    </TabItem>
                    <TabItem Header="{Binding TableOfContentsTabLabel}">
                        <DockPanel Margin="12">
                            <ListBox
                                x:Name="TableOfContentsList"
                                ItemsSource="{Binding TableOfContents}"
                                BorderThickness="0"
                                Background="Transparent">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="4,4" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <EventSetter Event="MouseLeftButtonUp" Handler="OnTableOfContentsEntryClick" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type core:TableOfContentsEntry}">
                                        <TextBlock
                                            Text="{Binding Text}"
                                            TextTrimming="CharacterEllipsis"
                                            Margin="{Binding Level, Converter={StaticResource HeadingLevelToIndentConverter}}" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock
                                DockPanel.Dock="Bottom"
                                Text="{Binding NoHeadingsLabel}"
                                Opacity="0.6"
                                FontSize="12"
                                Margin="4,8,4,0"
                                TextWrapping="Wrap"
                                Visibility="{Binding TableOfContents.Count, Converter={StaticResource CountToVisibilityConverter}}" />
                        </DockPanel>
                    </TabItem>
                </TabControl>
            </Border>

            <!-- Contenu principal : Lecture, Édition, ou les deux (vue partagée). -->
            <Grid
                x:Name="ContentGrid"
                Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Éditeur AvalonEdit (mode Édition ou moitié gauche de la vue partagée). -->
                <Border
                    x:Name="EditorHost"
                    Grid.Column="0"
                    BorderThickness="0,0,1,0">
                    <avalonEdit:TextEditor
                        x:Name="SourceEditor"
                        FontFamily="Cascadia Code, Consolas, Courier New"
                        FontSize="14"
                        ShowLineNumbers="True"
                        WordWrap="True"
                        Padding="12"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto" />
                </Border>

                <!-- Rendu Lecture (mode Lecture ou moitié droite de la vue partagée). -->
                <Grid
                    x:Name="ReadingHost"
                    Grid.Column="1">
                    <FlowDocumentScrollViewer
                        Document="{Binding RenderedDocument}"
                        IsToolBarVisible="False"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto"
                        Padding="24" />
                </Grid>
            </Grid>

            <!-- Indication visuelle de zone de dépôt (glisser-déposer). -->
            <Border
                x:Name="DragOverlay"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Background="#66000000"
                Visibility="Collapsed"
                IsHitTestVisible="False">
                <TextBlock
                    Text="{Binding DragDropHintLabel}"
                    Foreground="White"
                    FontSize="20"
                    FontWeight="SemiBold"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center" />
            </Border>
        </Grid>

        <!-- Barre d'état : statistiques du document et messages d'erreur. -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                Padding="16,6"
                BorderThickness="0,1,0,0">
                <TextBlock
                    Text="{Binding StatusMessage}"
                    Opacity="0.7"
                    FontSize="12" />
            </Border>

            <Border
                Grid.Column="1"
                Padding="16,6"
                BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        Text="{Binding WordCountLabel}"
                        Opacity="0.7"
                        FontSize="12"
                        Margin="0,0,16,0" />
                    <TextBlock
                        Text="{Binding CharacterCountLabel}"
                        Opacity="0.7"
                        FontSize="12"
                        Margin="0,0,16,0" />
                    <TextBlock
                        Text="{Binding ReadingTimeLabel}"
                        Opacity="0.7"
                        FontSize="12" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>